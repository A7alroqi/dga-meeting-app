{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "./build.sh",
  "outputDirectory": "public",
  "regions": ["sin1"],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api?path=:path*"
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
