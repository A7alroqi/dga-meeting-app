{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "./build.sh",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/[...path].ts": {
      "includeFiles": "server/data/**"
    }
  },
  "env": {
    "NODE_ENV": "production"
  }
}
